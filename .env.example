# Copie para .env (que está no .gitignore) e troque os valores: cp .env.example .env
# Valores FICTÍCIOS — nunca coloque segredos reais neste arquivo.

# PostgreSQL (dev)
POSTGRES_DB=clinicaviene
POSTGRES_USER=clinicaviene
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_PORTA=5432

# Mailpit (dev)
MAILPIT_PORTA_SMTP=1025
MAILPIT_PORTA_WEB=8025

# SeaweedFS — storage S3 de dev (D-056)
SEAWEEDFS_PORTA_S3=8333

# Backend em container (docker compose --profile app)
BACKEND_PORTA=8080
FRONTEND_PORTA=4200

# OpenAPI / Swagger UI (http://localhost:8080/swagger-ui.html) — só em dev
OPENAPI_HABILITADO=true

# Chaves de criptografia (D-052). Sem elas o backend não sobe.
# Gere chaves próprias com:  openssl rand -base64 32
# Os valores abaixo são marcadores e NÃO funcionam — substitua no seu .env.
# Chave perdida = dado cifrado irrecuperável: guarde as chaves de produção em cofre, separadas do backup do banco.
CRIPTO_CHAVES=v1:GERE-COM-openssl-rand-base64-32
CRIPTO_CHAVE_ATIVA=v1
CPF_HMAC_CHAVE=GERE-COM-openssl-rand-base64-32
