# Copie para .env (que está no .gitignore) e troque os valores: cp .env.example .env
# Valores FICTÍCIOS — nunca coloque segredos reais neste arquivo.

# PostgreSQL (dev)
POSTGRES_DB=clinicaviene
POSTGRES_USER=clinicaviene
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_PORTA=5432

# Mailpit (dev)
MAILPIT_PORTA_SMTP=1025
MAILPIT_PORTA_WEB=8025

# SeaweedFS — storage S3 de dev (D-056)
SEAWEEDFS_PORTA_S3=8333

# Backend em container (docker compose --profile app)
BACKEND_PORTA=8080
FRONTEND_PORTA=4200

# Chaves de criptografia do CPF (D-052) — entram na Fase 2. Exemplo de formato, NÃO usar estes valores:
# CRIPTO_CHAVES=v1:<chave-aes-256-em-base64>
# CRIPTO_CHAVE_ATIVA=v1
# CPF_HMAC_CHAVE=<chave-hmac-em-base64>
