# Regras do Lombok no projeto — ver docs/DECISOES.md D-051
# Não procurar lombok.config em diretórios acima deste.
config.stopBubbling = true
# Marca o código gerado com @lombok.Generated: o JaCoCo ignora esse código na cobertura
# e o teste ArchUnit (EntidadesLombokArchTest) usa essa marca para detectar anotações proibidas.
lombok.addLombokGeneratedAnnotation = true
